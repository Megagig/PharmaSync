# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/pharmasync

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_token_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX=100 # limit each IP to 100 requests per windowMs

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TTL=3600 # Default TTL for cache items (1 hour)

# Redis Cluster Configuration
REDIS_CLUSTER_ENABLED=false
REDIS_CLUSTER_URL=redis://localhost:6379
REDIS_CLUSTER_NODES=redis://localhost:6379,redis://localhost:6380,redis://localhost:6381

# Email Configuration (Brevo)
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=noreply@pharmasync.com
EMAIL_FROM_NAME=PharmaSync
MOCK_EMAILS=false  # Set to true to mock emails in development mode

# Email Fallback Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password  # Use app password for Gmail
SMTP_SECURE=false # true for 465, false for other ports
