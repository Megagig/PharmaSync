<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Receipt - {{transaction.saleNumber}}</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      font-size: 12px;
      line-height: 1.4;
      color: #333;
      max-width: 800px;
      margin: 0 auto;
      padding: 20px;
    }
    .receipt {
      border: 1px solid #ddd;
      padding: 20px;
      margin-bottom: 20px;
    }
    .header {
      text-align: center;
      margin-bottom: 20px;
    }
    .logo {
      max-width: 150px;
      margin-bottom: 10px;
    }
    .store-info {
      margin-bottom: 10px;
    }
    .transaction-info {
      margin-bottom: 20px;
      border-top: 1px solid #ddd;
      border-bottom: 1px solid #ddd;
      padding: 10px 0;
    }
    .customer-info {
      margin-bottom: 20px;
    }
    .items {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }
    .items th, .items td {
      border: 1px solid #ddd;
      padding: 8px;
      text-align: left;
    }
    .items th {
      background-color: #f2f2f2;
    }
    .totals {
      width: 100%;
      margin-bottom: 20px;
    }
    .totals td {
      padding: 5px;
    }
    .totals .label {
      text-align: right;
      font-weight: bold;
    }
    .totals .value {
      text-align: right;
    }
    .payment-info {
      margin-bottom: 20px;
    }
    .footer {
      text-align: center;
      margin-top: 20px;
      font-size: 10px;
      color: #666;
    }
    .return-info {
      margin-top: 20px;
      padding: 10px;
      border: 1px solid #ddd;
      background-color: #f9f9f9;
    }
    .loyalty-info {
      margin-top: 10px;
      padding: 10px;
      border: 1px dashed #ddd;
      background-color: #f9f9f9;
    }
    .prescription-info {
      margin-top: 10px;
      padding: 10px;
      border: 1px solid #eee;
      background-color: #f5f5f5;
    }
    .barcode {
      text-align: center;
      margin: 20px 0;
    }
    .barcode img {
      max-width: 250px;
    }
    @media print {
      body {
        padding: 0;
        font-size: 10px;
      }
      .receipt {
        border: none;
        padding: 0;
      }
      .no-print {
        display: none;
      }
    }
  </style>
</head>
<body>
  <div class="receipt">
    <div class="header">
      <h1>{{store.name}}</h1>
      <div class="store-info">
        <p>{{store.address}}</p>
        <p>Phone: {{store.phone}} | Email: {{store.email}}</p>
        <p>Website: {{store.website}}</p>
      </div>
    </div>

    <div class="transaction-info">
      {{#if transaction.isReturn}}
        <h2>RETURN RECEIPT</h2>
      {{else if transaction.isExchange}}
        <h2>EXCHANGE RECEIPT</h2>
      {{else if transaction.isVoid}}
        <h2>VOID RECEIPT</h2>
      {{else}}
        <h2>SALES RECEIPT</h2>
      {{/if}}
      <p><strong>Receipt #:</strong> {{transaction.saleNumber}}</p>
      <p><strong>Date:</strong> {{formatDate transaction.saleDate}}</p>
      <p><strong>Cashier:</strong> {{transaction.cashier.firstName}} {{transaction.cashier.lastName}}</p>
      <p><strong>Register:</strong> {{transaction.register}}</p>
      
      {{#if transaction.originalSale}}
        <p><strong>Original Sale:</strong> {{transaction.originalSale.saleNumber}} ({{formatDateShort transaction.originalSale.saleDate}})</p>
      {{/if}}
    </div>

    {{#if transaction.customer}}
      <div class="customer-info">
        <h3>Customer Information</h3>
        <p><strong>Name:</strong> {{transaction.customer.firstName}} {{transaction.customer.lastName}}</p>
        <p><strong>Customer #:</strong> {{transaction.customer.customerNumber}}</p>
        {{#if transaction.customer.phone}}
          <p><strong>Phone:</strong> {{transaction.customer.phone}}</p>
        {{/if}}
        {{#if transaction.customer.email}}
          <p><strong>Email:</strong> {{transaction.customer.email}}</p>
        {{/if}}
      </div>
    {{/if}}

    {{#if transaction.prescription}}
      <div class="prescription-info">
        <h3>Prescription Information</h3>
        <p><strong>Prescription #:</strong> {{transaction.prescription.prescriptionNumber}}</p>
        <p><strong>Issue Date:</strong> {{formatDateShort transaction.prescription.issueDate}}</p>
        {{#if transaction.doctor}}
          <p><strong>Doctor:</strong> Dr. {{transaction.doctor.firstName}} {{transaction.doctor.lastName}}</p>
        {{/if}}
      </div>
    {{/if}}

    <div class="items-section">
      <h3>Items</h3>
      <table class="items">
        <thead>
          <tr>
            <th>Item</th>
            <th>SKU</th>
            <th>Qty</th>
            <th>Unit Price</th>
            <th>Discount</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          {{#each transaction.items}}
            <tr>
              <td>{{this.product.name}}</td>
              <td>{{this.product.sku}}</td>
              <td>{{this.quantity}}</td>
              <td>{{formatCurrency this.unitPrice}}</td>
              <td>{{#if this.discount}}{{formatCurrency this.discount}}{{else}}0.00{{/if}}</td>
              <td>{{formatCurrency this.subtotal}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <table class="totals">
      <tr>
        <td class="label">Subtotal:</td>
        <td class="value">{{formatCurrency transaction.subtotal}}</td>
      </tr>
      {{#if transaction.discount}}
        <tr>
          <td class="label">Discount:</td>
          <td class="value">{{formatCurrency transaction.discount}}</td>
        </tr>
      {{/if}}
      {{#if transaction.loyaltyDiscount}}
        <tr>
          <td class="label">Loyalty Discount:</td>
          <td class="value">{{formatCurrency transaction.loyaltyDiscount}}</td>
        </tr>
      {{/if}}
      {{#if transaction.tax}}
        <tr>
          <td class="label">Tax:</td>
          <td class="value">{{formatCurrency transaction.tax}}</td>
        </tr>
      {{/if}}
      <tr>
        <td class="label"><strong>Total:</strong></td>
        <td class="value"><strong>{{formatCurrency transaction.total}}</strong></td>
      </tr>
    </table>

    <div class="payment-info">
      <h3>Payment Information</h3>
      {{#each transaction.paymentMethods}}
        <p><strong>{{this.method}}:</strong> {{formatCurrency this.amount}}
        {{#if this.reference}} (Ref: {{this.reference}}){{/if}}
        {{#if this.cardType}} ({{this.cardType}} ending in {{this.cardLast4}}){{/if}}
        </p>
      {{/each}}
      
      {{#if transaction.changeDue}}
        <p><strong>Change Due:</strong> {{formatCurrency transaction.changeDue}}</p>
      {{/if}}
    </div>

    {{#if transaction.loyaltyPointsEarned}}
      <div class="loyalty-info">
        <h3>Loyalty Program</h3>
        <p><strong>Points Earned:</strong> {{transaction.loyaltyPointsEarned}}</p>
        {{#if transaction.loyaltyPointsRedeemed}}
          <p><strong>Points Redeemed:</strong> {{transaction.loyaltyPointsRedeemed}}</p>
        {{/if}}
      </div>
    {{/if}}

    {{#if transaction.isReturn}}
      <div class="return-info">
        <h3>Return Information</h3>
        <p><strong>Return Reason:</strong> {{transaction.returnReason}}</p>
        {{#if transaction.returnReasonDetails}}
          <p><strong>Details:</strong> {{transaction.returnReasonDetails}}</p>
        {{/if}}
      </div>
    {{/if}}

    {{#if transaction.notes}}
      <div class="notes">
        <h3>Notes</h3>
        <p>{{transaction.notes}}</p>
      </div>
    {{/if}}

    {{#if transaction.refillReminder}}
      <div class="refill-info">
        <h3>Refill Reminder</h3>
        <p>Your next refill is scheduled for: {{formatDateShort transaction.refillReminderDate}}</p>
      </div>
    {{/if}}

    <div class="barcode">
      <!-- Barcode would be generated and inserted here -->
      <p>{{transaction.saleNumber}}</p>
    </div>

    <div class="footer">
      <p>Thank you for your business!</p>
      {{#if transaction.returnPolicy}}
        <p>Return Policy: {{transaction.returnPolicy}}</p>
      {{else}}
        <p>Return Policy: Items may be returned within 30 days with receipt.</p>
      {{/if}}
      <p>This receipt was generated on {{formatDate date}}</p>
    </div>
  </div>

  <div class="no-print">
    <button onclick="window.print()">Print Receipt</button>
  </div>
</body>
</html>
